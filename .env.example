# Conta no Supabase (opcional). Sem as duas variáveis, o app não mostra nada de conta.
# Copie para .env.local (nunca commitado) e preencha com os dados do projeto (Settings → API).
# A chave publicável é pública por desenho; a proteção vem da RLS. Nunca use a secret/service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
